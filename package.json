{
  "name": "adlabs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "vitest run --fileParallelism=false --test-timeout=15000 --hook-timeout=15000 src/ingestion/persistence/__tests__/persistence.integration.test.ts src/ingestion/media-orchestration/__tests__/media-orchestration.integration.test.ts src/ingestion/media-orchestration/__tests__/atomic-ingestion.integration.test.ts src/ingestion/run-orchestration/__tests__/run-curious-coder.integration.test.ts src/discovery/projection/__tests__/projector.integration.test.ts",
    "test:r2": "vitest run src/storage/__tests__/r2-live.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:target && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:target": "tsx --conditions=react-server scripts/db-target.ts",
    "db:rebuild-discovery-index": "tsx --conditions=react-server scripts/rebuild-discovery-index.ts",
    "ingest:curious-coder:dev": "tsx --conditions=react-server scripts/ingest-curious-coder-dev.ts",
    "media:benchmark:dev": "tsx --conditions=react-server scripts/media-benchmark-dev.ts",
    "media:backfill:dev": "tsx --conditions=react-server scripts/media-backfill-dev.ts",
    "media:metadata-backfill:dev": "tsx --conditions=react-server scripts/media-metadata-backfill-dev.ts",
    "corpus:sample:dev": "tsx --conditions=react-server scripts/corpus-sample-dev.ts",
    "corpus:sample-batch:dev": "tsx --conditions=react-server scripts/corpus-sample-batch-dev.ts",
    "corpus:audit:dev": "tsx --conditions=react-server scripts/corpus-audit-dev.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "apify-client": "^2.25.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
