{
  "name": "adlabs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:db": "vitest run src/ingestion/persistence/__tests__/persistence.integration.test.ts",
    "test:r2": "vitest run src/storage/__tests__/r2-live.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm db:target && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:target": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/db-target.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1110.0",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@next/env": "^16.3.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@11.21.0"
}
