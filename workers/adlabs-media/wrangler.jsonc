{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adlabs-media-dev",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "brainfoods-ads-dev"
    }
  ],
  "routes": [
    {
      "pattern": "media.brainfoods.in",
      "custom_domain": true
    }
  ]
}